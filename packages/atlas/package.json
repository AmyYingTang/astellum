{
  "name": "@astellum/atlas",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:client": "vite build",
    "build:server": "tsc -b",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@astellum/identify": "workspace:*",
    "@astellum/reader": "workspace:*",
    "@astellum/schema": "workspace:*",
    "express": "^4.21.2",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "vite": "^5.4.11"
  }
}
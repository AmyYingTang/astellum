#!/usr/bin/env bash
#
# astrolens 便捷运行脚本
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI="$ROOT/packages/cli/dist/index.js"

cd "$ROOT"

usage() {
  cat <<'EOF'
astrolens 便捷运行脚本

  ./quickastrolens                              打开 studio(首页:新建 / 打开已有)
  ./quickastrolens setup                        安装依赖并构建所有包(首次使用)
  ./quickastrolens build                        重新构建
  ./quickastrolens identify <图片> [对象名]       只识别(plate-solve+查目录)→ factsheet.json
  ./quickastrolens read <图片> [对象名] [语言]    识别 + AI 解读 + 渲染,一步到位
  ./quickastrolens render <reading.json> [格式]  渲染 annotated|embed|poster|all
  ./quickastrolens edit <reading.json> [端口]    打开本地编辑器,浏览器里微调圈和文字
  ./quickastrolens atlas [端口]                  打开基准标注库工具(B 类形态标注,默认端口 3100)
  ./quickastrolens help                         显示帮助

现场(onsite)相关 —— 离线、预定义解读、全屏展示:

  ./quickastrolens prefetch [check|targets]     下载离线星表包(出发前联网跑一次)
                                                  check   = 只报告磁盘上有什么,不下载
                                                  targets = 预热在线答案快照(按标注库目标)
  ./quickastrolens kiosk <图片> [对象名]          一键:识别 → 预定义解读 → 全屏可点页面
  ./quickastrolens watch <目录> [对象名]          监听目录,每来一张新图自动出一张全屏页
  ./quickastrolens readings                     预定义解读覆盖率:哪些目标还没录、缺哪几项
  ./quickastrolens draft [目标|all]              用 AI 起草预定义解读(联网;写入随包解读库)

提示:把 ASTROMETRY_API_KEY 放进仓库根的 .env(identify / read / studio 都会自动读)。
提示:现场模式请先 `./quickastrolens prefetch`,再用 `prefetch check` 确认可以断网。

示例:
  ./quickastrolens setup
  ./quickastrolens identify new/NGC3372_annotated.jpg "NGC 3372"
  ./quickastrolens read new/NGC3372_annotated.jpg "NGC 3372"
  ./quickastrolens edit out/NGC3372_annotated/reading.json
  ./quickastrolens kiosk new/NGC3372_annotated.jpg "NGC 3372"
EOF
}

ensure_pnpm() {
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "==> 启用 pnpm (corepack)"
    corepack enable pnpm
  fi
}

ensure_built() {
  if [ ! -f "$CLI" ]; then
    echo "==> 未发现构建产物,先构建"
    ensure_pnpm
    pnpm build
  fi
}

cmd="${1:-studio}"
case "$cmd" in
  studio)
    ensure_built
    # Curator context → the co-launched atlas edits the shipped seed.
    node "$CLI" studio --atlas-data-dir "$ROOT/packages/atlas/data"
    ;;

  setup)
    ensure_pnpm
    echo "==> pnpm install"
    pnpm install
    echo "==> pnpm build"
    pnpm build
    echo "==> 完成。把 key 放进 .env,然后试试: ./quickastrolens identify new/NGC3372_annotated.jpg"
    ;;

  build)
    ensure_pnpm
    pnpm build
    ;;

  identify)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens identify <图片> [对象名]" >&2
      exit 1
    fi
    ensure_built
    image="$1"
    hint="${2:-}"
    base="$(basename "$image")"
    name="${base%.*}"
    out="$ROOT/out/$name"
    args=(identify "$image" --out "$out")
    if [ -n "$hint" ]; then
      args+=(--target "$hint")
    fi
    echo "==> 识别: $image -> $out/factsheet.json"
    node "$CLI" "${args[@]}"
    ;;

  read)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens read <图片> [对象名] [语言 zh|en]" >&2
      exit 1
    fi
    ensure_built
    image="$1"
    hint="${2:-}"
    lang="${3:-zh}"
    base="$(basename "$image")"
    name="${base%.*}"
    out="$ROOT/out/$name"

    args=(read "$image" --out "$out" --lang "$lang")
    if [ -n "$hint" ]; then
      args+=(--hint "$hint")
    fi

    echo "==> 读图: $image -> $out/reading.json"
    node "$CLI" "${args[@]}"
    if [ -f "$out/reading.json" ]; then
      echo "==> 渲染标注图"
      node "$CLI" render "$out/reading.json"
      echo "==> 完成: $out"
    else
      echo "==> 未生成 reading(无接地天体);见 $out/factsheet.json"
    fi
    ;;

  render)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens render <reading.json> [格式 annotated|embed|poster|all]" >&2
      exit 1
    fi
    ensure_built
    report="$1"
    fmt="${2:-annotated}"
    node "$CLI" render "$report" --format "$fmt"
    ;;

  edit)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens edit <reading.json> [端口]" >&2
      exit 1
    fi
    ensure_built
    report="$1"
    if [ $# -ge 2 ]; then
      node "$CLI" edit "$report" --port "$2"
    else
      node "$CLI" edit "$report"
    fi
    ;;

  atlas)
    shift
    ensure_built
    # This wrapper is the seed-curation entry point → write the shipped seed
    # (packages/atlas/data). Self-deployers extending their own atlas use the
    # bare CLI (`astrolens atlas`), which defaults to ~/.astrolens/atlas.
    args=(atlas --data-dir "$ROOT/packages/atlas/data")
    if [ $# -ge 1 ]; then args+=(--port "$1"); fi
    node "$CLI" "${args[@]}"
    ;;

  prefetch)
    shift
    ensure_built
    case "${1:-}" in
      check)   node "$CLI" prefetch --check ;;
      targets) node "$CLI" prefetch --targets ;;
      "")      node "$CLI" prefetch ;;
      *)
        echo "用法: ./quickastrolens prefetch [check|targets]" >&2
        exit 1
        ;;
    esac
    ;;

  kiosk)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens kiosk <图片> [对象名]" >&2
      echo "提示:带上对象名,现场识别会稳很多(它就是身份依据)。" >&2
      exit 1
    fi
    ensure_built
    image="$1"
    target="${2:-}"
    base="$(basename "$image")"
    name="${base%.*}"
    out="$ROOT/out/$name-kiosk"
    # This wrapper is the curator entry point, so the onsite profile is what's
    # wanted here even if the config file says otherwise.
    args=(kiosk "$image" --profile onsite --out "$out")
    if [ -n "$target" ]; then args+=(--target "$target"); fi
    echo "==> 现场识别: $image -> $out/kiosk.html"
    node "$CLI" "${args[@]}"
    ;;

  watch)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens watch <目录> [对象名]" >&2
      exit 1
    fi
    ensure_built
    dir="$1"
    target="${2:-}"
    args=(kiosk-watch "$dir" --profile onsite --out "$ROOT/out/kiosk")
    if [ -n "$target" ]; then args+=(--target "$target"); fi
    node "$CLI" "${args[@]}"
    ;;

  readings)
    shift
    ensure_built
    node "$CLI" readings "$@"
    ;;

  draft)
    shift
    ensure_built
    # Curator context, same as `atlas` above: drafts belong in the shipped
    # library (packages/atlas/data), not in one person's ~/.astrolens.
    lib="$ROOT/packages/atlas/data/readings.json"
    args=(readings-draft --out "$lib")
    case "${1:-}" in
      ""|all) args+=(--all) ;;
      *)      args=(readings-draft "$1" --out "$lib") ;;
    esac
    echo "==> 起草预定义解读 -> $lib"
    echo "    (需要联网 + 已登录的 claude CLI;产出标记为 ai_draft,待人工审核)"
    node "$CLI" "${args[@]}"
    ;;

  help | -h | --help)
    usage
    ;;

  *)
    echo "未知命令: $cmd" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
